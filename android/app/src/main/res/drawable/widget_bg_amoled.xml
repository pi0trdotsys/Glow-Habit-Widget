<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background of the "amoled" palette (WidgetTheme.backgroundRes; the app theme twin is
     [data-theme="amoled"] in src/styles.css). No tint: the per-widget opacity is the ImageView alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#000000"
        android:endColor="#000000"
        android:angle="135" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#1C1D22" />
</shape>
