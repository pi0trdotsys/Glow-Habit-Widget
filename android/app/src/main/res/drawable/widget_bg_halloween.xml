<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background of the "halloween" palette (WidgetTheme.backgroundRes; the app theme twin is
     [data-theme="halloween"] in src/styles.css). No tint: the per-widget opacity is the ImageView alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#261A3A"
        android:endColor="#120C1C"
        android:angle="135" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#322843" />
</shape>
