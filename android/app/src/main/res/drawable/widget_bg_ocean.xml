<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background of the "ocean" palette (WidgetTheme.backgroundRes; the app theme twin is
     [data-theme="ocean"] in src/styles.css). No tint: the per-widget opacity is the ImageView alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#0C2A3E"
        android:endColor="#021624"
        android:angle="135" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#16384D" />
</shape>
