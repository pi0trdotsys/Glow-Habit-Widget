<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background of the "sunset" palette (WidgetTheme.backgroundRes; the app theme twin is
     [data-theme="sunset"] in src/styles.css). No tint: the per-widget opacity is the ImageView alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#3A1C35"
        android:endColor="#1F0B1D"
        android:angle="135" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#4A2843" />
</shape>
