<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background of the "terminal" palette (WidgetTheme.backgroundRes; the app theme twin is
     [data-theme="terminal"] in src/styles.css). No tint: the per-widget opacity is the ImageView alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#051609"
        android:endColor="#020A03"
        android:angle="135" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="#1E5A2A" />
</shape>
