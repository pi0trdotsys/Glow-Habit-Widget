<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background of the "christmas" palette (WidgetTheme.backgroundRes; the app theme twin is
     [data-theme="christmas"] in src/styles.css). No tint: the per-widget opacity is the ImageView alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#032F1B"
        android:endColor="#02190D"
        android:angle="135" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#173B28" />
</shape>
