<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background of the "light" palette (WidgetTheme.backgroundRes; the app theme twin is
     [data-theme="light"] in src/styles.css). No tint: the per-widget opacity is the ImageView alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FFFFFF"
        android:endColor="#F1F2F6"
        android:angle="135" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#E1E3E9" />
</shape>
