    android:width="24dp" android:height="24dp"
    android:viewportWidth="64" android:viewportHeight="64">
    <!-- ears -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M9 29 L15 4 L29 18 Z M55 29 L49 4 L35 18 Z" />
    <!-- head with smug slit eyes and nose cut out -->
    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
        android:pathData="M7,38 a25,22 0 1,0 50,0 a25,22 0 1,0 -50,0 Z
            M16 35 Q23 30.5 30 35 Q23 38.5 16 35 Z
            M34 35 Q41 30.5 48 35 Q41 38.5 34 35 Z
            M28.5 43 L35.5 43 L32 47 Z" />
