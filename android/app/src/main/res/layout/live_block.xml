<?xml version="1.0" encoding="utf-8"?>
<!-- Night guard full-screen block (LiveBlock): drawn over the social media app after the 3rd jab. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/live_block_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/block_cat"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_szpila_angry" />

        <TextView
            android:id="@+id/block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.2"
            android:text="SZPILA"
            android:textColor="#FF4D5E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="#F4F5F9"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#B3F4F5F9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/block_sleep"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/live_block_button"
            android:gravity="center"
            android:text="😴  Idę spać"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/block_hold"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/live_block_hold_bg">

            <ProgressBar
                android:id="@+id/block_hold_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/live_block_hold_progress" />

            <TextView
                android:id="@+id/block_hold_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Przytrzymaj 10 s, jeśli naprawdę musisz"
                android:textColor="#CCF4F5F9"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
