<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 "Następne zadanie": the planner's pick for right now. Tap the ring to
     log it (one step / confirm clean), tap the text to open the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget2_bg"
    android:padding="6dp">

    <FrameLayout android:id="@+id/next_ring_box"
        android:layout_width="48dp" android:layout_height="48dp">
        <ImageView android:id="@+id/next_ring"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:contentDescription="Postęp zadania" />
        <ImageView android:id="@+id/next_icon"
            android:layout_width="22dp" android:layout_height="22dp"
            android:layout_gravity="center" android:contentDescription="" />
    </FrameLayout>

    <LinearLayout android:id="@+id/next_text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:layout_marginTop="3dp">
        <TextView android:id="@+id/next_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:text="Loop" android:textColor="#f4f5f9" android:textSize="11sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/next_sub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:text="" android:textColor="#60e7b4" android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
