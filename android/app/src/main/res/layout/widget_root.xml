<?xml version="1.0" encoding="utf-8"?>
<!-- The background is an ImageView behind the content: its alpha is the per-widget
     opacity (WidgetPrefs.applyOpacity, chosen in WidgetConfigActivity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:contentDescription="@null" />

<LinearLayout
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#f4f5f9"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="Szpila"
            style="@style/WidgetTextShadow" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9398a5"
            android:textSize="11sp"
            android:text="@string/widget_today_habits"
            style="@style/WidgetTextShadow" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#9398a5"
        android:textSize="13sp"
        android:text="@string/widget_empty"
        style="@style/WidgetTextShadow" />
</LinearLayout>
</FrameLayout>
