<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect client needs API 26; calls are guarded by HealthSteps.available(). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- No MAIN/LAUNCHER here: the launcher entry is one of the .Icon* aliases below. -->
            <!-- Health Connect: "why does Szpila need steps" (Android 13 and older) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Launcher icon per app theme (AppIcon.java): exactly one alias is enabled, IconDark
             (the original icon) by default; icons from scripts/gen-launcher-icons.ts. -->
        <activity-alias
            android:name=".IconDark"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAmoled"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amoled"
            android:roundIcon="@mipmap/ic_launcher_amoled_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGlitch"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_glitch"
            android:roundIcon="@mipmap/ic_launcher_glitch_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconTerminal"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_terminal"
            android:roundIcon="@mipmap/ic_launcher_terminal_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOcean"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSunset"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset"
            android:roundIcon="@mipmap/ic_launcher_sunset_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSakura"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sakura"
            android:roundIcon="@mipmap/ic_launcher_sakura_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Hold-to-complete overlay: widget taps open it, holding the ring logs the task -->
        <activity
            android:name=".HoldActivity"
            android:exported="false"
            android:theme="@style/Theme.Loop.Hold"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="app.lovable.glow_habit_widget.hold" />

        <!-- Widget settings (background transparency, ticker lines): shown by the launcher when a
             widget is placed and on "reconfigure" (Android 12+). Exported for the launcher; it only
             accepts appWidgetIds that belong to this app. -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.Szpila.Config"
            android:excludeFromRecents="true"
            android:taskAffinity="app.lovable.glow_habit_widget.widgetconfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Kropi logged water: pull it into the "kropi" habits (only Kropi can send this) -->
        <receiver
            android:name=".KropiReceiver"
            android:exported="true"
            android:permission="com.kropi.hydration.permission.READ_HYDRATION">
            <intent-filter>
                <action android:name="com.kropi.hydration.action.HYDRATION_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Health Connect permission usage screen (Android 14+) opens the app -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen habit widget -->
        <receiver android:name=".HabitWidgetProvider" android:exported="false"
            android:label="@string/widget_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.lovable.glow_habit_widget.TOGGLE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".HabitWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false"
        />

        <!-- Icon widget (progress ring + day countdown) -->
        <receiver android:name=".HabitWidget2Provider" android:exported="false"
            android:label="@string/widget_icons_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.lovable.glow_habit_widget.TOGGLE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info2" />
        </receiver>

        <!-- 1x1 "next task" widget -->
        <receiver android:name=".NextTaskWidgetProvider" android:exported="false"
            android:label="@string/widget_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.lovable.glow_habit_widget.TOGGLE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info3" />
        </receiver>

        <!-- 4x1 Szpila widget (the mean cat + one jab, habits to do only) -->
        <receiver android:name=".SzpilaWidgetProvider" android:exported="false"
            android:label="@string/widget_szpila_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info4" />
        </receiver>

        <!-- Progress notification + Szpila: alarm ticks, notification action, re-arm after reboot/update -->
        <receiver android:name=".NotifierReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Night guard: while 00:00-05:00, Szpila pops up the moment a social media app opens -->
        <service
            android:name=".LiveGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled night guard: detects social media apps opened after midnight (usage access) and shows a reminder to put the phone away." />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Steps from Health Connect (incl. background reads for widgets/notifications) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Sleep from the band (Mi Fitness -> Health Connect) for the night bill -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Late-night screen time; granted by the user under "Usage access" -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Night guard (foreground service started by an exact alarm at midnight) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Night guard block: full-screen Szpila over the social media app (granted by the user) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Water from Kropi (the user's hydration app, same signing key): read its days -->
    <uses-permission android:name="com.kropi.hydration.permission.READ_HYDRATION" />
    <!-- The phone's calendars (any synced account, e.g. work via Outlook/Exchange): busy meetings only -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <queries>
        <package android:name="com.kropi.hydration" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="kropi" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- social media apps watched by the night guard (LiveGuard.SOCIAL) -->
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.twitter.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.pinterest" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.linkedin.android" />
        <!-- launchable apps: the night curfew's allow list, step sources (Mi Fitness, ...) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- the curfew always lets the home screen, the clock and the dialer through -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>
</manifest>
